<div id="home" phx-hook="Home" class="h-screen bg-zinc-50 flex flex-col relative overflow-hidden">
  <div class="relative z-20 shadow-lg border-b border-gray-200">
    <div class="flex items-center justify-between p-4">
      <div class="flex items-center space-x-4">
        <div class="flex items-center space-x-3">
          <div>
            <h1 class="text-gray-900 font-semibold text-lg">{@meeting.title}</h1>
            <div class="flex items-center space-x-4 text-sm text-gray-600">
              <span id="meeting-time" class="font-medium">00:00</span>
              <div class="flex items-center space-x-1">
                <span id="viewercount">1</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="flex items-center space-x-4 text-sm text-gray-600">
        <div class="flex items-center space-x-2">
          <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
          <span>Connected</span>
        </div>
      </div>
    </div>
  </div>

  <div
    id="join-error-message"
    class="absolute inset-0 hidden bg-black/50 backdrop-blur-sm flex items-center justify-center z-50"
  >
    <div class="bg-white rounded-xl p-8 text-center max-w-md shadow-2xl">
      <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-6">
      </div>
      <h3 class="text-gray-900 font-semibold text-lg mb-3">Connection Failed</h3>
      <p id="error-text" class="text-gray-600 mb-6">
        Unable to join the meeting room. Please check your connection and try again.
      </p>
      <div class="flex space-x-3">
        <button
          onclick="window.callControls?.retryConnection()"
          class="flex-1 px-4 py-2 bg-bluePrimary hover:bg-bluePrimary/90 text-white rounded-lg font-medium transition-colors"
        >
          Try Again
        </button>
        <button class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-medium transition-colors">
          Cancel
        </button>
      </div>
    </div>
  </div>
  
<!-- Main Video Area -->
  <div class="flex-1 relative bg-white">
    <!-- Default Grid Layout (No Screen Share) -->
    <div
      id="videoplayer-wrapper"
      class="absolute inset-0 p-6 flex flex-col lg:flex-row gap-y-5 max-h-screen"
      data-layout="default"
    >
      <!-- Local Video (You) -->
      <div id="local-video-container" class="relative group">
        <video
          id="videoplayer-local"
          class="w-full h-full lg:max-h-none object-cover rounded-xl bg-gray-900 shadow-lg border-2 border-bluePrimary shadow-md"
          autoplay
          muted
          playsinline
        >
        </video>
        
<!-- Video Overlay Info -->
        <div class="absolute inset-0 pointer-events-none">
          <!-- Name Label -->
          <div class="absolute bottom-4 left-4 pointer-events-auto">
            <div class="bg-white/90 backdrop-blur-sm rounded-lg px-3 py-1.5">
              <span class="text-gray-900 text-sm font-medium">You</span>
            </div>
          </div>
          
<!-- Status Indicators (Camera & Microphone) -->
          <div class="absolute bottom-4 right-4 flex flex-col gap-2 pointer-events-auto">
            <!-- Microphone Status -->
            <div
              id="local-mic-status"
              class={"flex items-center space-x-2 backdrop-blur-sm rounded-lg px-3 py-2 transition-all duration-300 shadow-lg #{if @muted, do: "bg-red-500/90", else: "bg-green-500/90"}"}
            >
              <%= if @muted do %>
                <svg
                  class="w-5 h-5 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                    clip-rule="evenodd"
                  >
                  </path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"
                  >
                  </path>
                </svg>
                <span class="text-white text-xs font-semibold">MUTED</span>
              <% else %>
                <svg
                  class="w-5 h-5 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
                  >
                  </path>
                </svg>
                <span class="text-white text-xs font-semibold">ON</span>
              <% end %>
            </div>
            
<!-- Camera Status -->
            <div
              id="local-camera-status"
              class={"flex items-center space-x-2 backdrop-blur-sm rounded-lg px-3 py-2 transition-all duration-300 shadow-lg #{if @video_enabled, do: "bg-blue-500/90", else: "bg-red-500/90"}"}
            >
              <%= if @video_enabled do %>
                <svg
                  class="w-5 h-5 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                  >
                  </path>
                </svg>
                <span class="text-white text-xs font-semibold">ON</span>
              <% else %>
                <svg
                  class="w-5 h-5 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M16 8l2.29-2.29a1 1 0 011.71.71v7.16a1 1 0 01-1.71.71L16 12M5 16h6a1 1 0 001-1V9a1 1 0 00-1-1H5a1 1 0 00-1 1v6a1 1 0 001 1z"
                  >
                  </path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 3l18 18"
                  >
                  </path>
                </svg>
                <span class="text-white text-xs font-semibold">OFF</span>
              <% end %>
            </div>
          </div>
          
<!-- Connection Quality -->
          <div class="absolute top-4 left-4 pointer-events-auto">
            <div
              id="connection-quality"
              class="flex items-center space-x-1 bg-white/90 backdrop-blur-sm rounded-lg px-2 py-1"
            >
              <div id="connection-status" class="w-2 h-2 bg-green-500 rounded-full animate-pulse">
              </div>
              <span class="text-gray-900 text-xs font-medium">HD</span>
            </div>
          </div>
        </div>
      </div>
      
<!-- Remote Video (Other Participant) -->
      <div id="remote-video-container" class="relative group hidden">
        <video
          id="videoplayer-remote"
          class="w-full h-full object-cover rounded-xl bg-gray-900 shadow-lg border-2 border-gray-200"
          autoplay
          playsinline
          muted
        >
        </video>
        
<!-- Video Overlay Info -->
        <div class="absolute inset-0 pointer-events-none">
          <!-- Name Label -->
          <div class="absolute bottom-4 left-4 pointer-events-auto">
            <div class="bg-white/90 backdrop-blur-sm rounded-lg px-3 py-1.5">
              <span id="remote-participant-name" class="text-gray-900 text-sm font-medium">
                Participant
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
    
<!-- Screen Share Layout -->
    <div id="screenshare-layout" class="absolute inset-0 p-6 hidden" data-layout="screenshare">
      <!-- Main Screen Share Area (Large) -->
      <div class="h-full flex flex-col gap-3">
        <!-- Screen Share Video (Takes most space) -->
        <div class="flex-1 relative">
          <video
            id="videoplayer-screenshare"
            class="w-full lg:h-[700px] sm:h-[500px] object-contain rounded-xl bg-gray-900 shadow-lg border-2 border-gray-200"
            autoplay
            playsinline
          >
          </video>
          
<!-- Screen Share Overlay Info -->
          <div class="absolute inset-0 pointer-events-none">
            <!-- Name Label -->
            <div class="absolute bottom-4 left-4 pointer-events-auto">
              <div class="bg-white/90 backdrop-blur-sm rounded-lg px-3 py-1.5">
                <span id="screenshare-participant-name" class="text-gray-900 text-sm font-medium">
                  Screen Share
                </span>
              </div>
            </div>
          </div>
        </div>
        
<!-- Participant Videos (Small strip at bottom) -->
        <div class="flex-none h-32 flex flex-row gap-3 overflow-x-auto">
          <!-- Local Video (Small) -->
          <div id="local-video-small" class="w-48 h-32 relative group flex-shrink-0">
            <video
              id="videoplayer-local-small"
              class="w-full h-full object-cover rounded-lg bg-gray-900 shadow-md border border-gray-300"
              autoplay
              muted
              playsinline
              webkit-playsinline="true"
            >
            </video>
            
<!-- Small Video Overlay -->
            <div class="absolute inset-0 rounded-lg bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none">
              <div class="absolute bottom-2 left-2 pointer-events-auto">
                <div class="bg-white/90 backdrop-blur-sm rounded px-2 py-1">
                  <span class="text-gray-900 text-xs font-medium">You</span>
                </div>
              </div>
            </div>
          </div>
          
<!-- Remote Video (Small) -->
          <div
            id="remote-video-small"
            class="w-48 h-32 relative group flex-shrink-0 hidden"
            style="display: none;"
          >
            <video
              id="videoplayer-remote-small"
              class="w-full h-full object-cover rounded-lg bg-gray-900 shadow-md border-2 border-blue-400"
              autoplay
              playsinline
              muted
              webkit-playsinline="true"
            >
            </video>
            
<!-- Small Video Overlay with always-visible camera indicator -->
            <div class="absolute inset-0 rounded-lg pointer-events-none">
              <!-- Participant Name - Always visible -->
              <div class="absolute top-2 left-2 pointer-events-auto">
                <div class="bg-blue-500/90 backdrop-blur-sm rounded px-2 py-1 flex items-center space-x-1 shadow-lg">
                  <svg
                    class="w-3 h-3 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                    >
                    </path>
                  </svg>
                  <span
                    id="remote-participant-name-small"
                    class="text-white text-xs font-semibold"
                  >
                    Participant
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
<!-- Stop Screen Share Button (overlay) -->
      <button
        id="stop-screenshare-btn"
        class="absolute top-8 right-8 hidden bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-medium transition-colors shadow-lg"
      >
        Stop Sharing
      </button>
    </div>
  </div>
  
<!-- Bottom Controls Bar -->
  <div class="relative z-20 bg-bgSecondary/80 backdrop-blur-xl shadow-2xl border border-gray-200/50 mx-4 rounded-2xl my-4">
    <div class="px-6 py-5">
      <!-- Mobile Permission Helper (Shows only on mobile when needed) -->
      <div
        id="mobile-permission-helper"
        class="hidden mb-4 p-4 bg-gradient-to-r from-blue-50/90 to-indigo-50/90 backdrop-blur-sm border border-blue-200/50 rounded-xl shadow-sm"
      >
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl flex items-center justify-center flex-shrink-0 shadow-md">
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-blue-900">Requesting Camera & Microphone</p>
            <p class="text-xs text-blue-700/80">
              Please allow access when prompted by your browser
            </p>
          </div>
          <div class="flex-shrink-0">
            <div class="w-5 h-5 border-2 border-blue-600 border-t-transparent rounded-full animate-spin">
            </div>
          </div>
        </div>
      </div>
      
<!-- Main Controls -->
      <div class="flex items-center justify-center space-x-3">
        <!-- Microphone -->
        <button
          id="mute-btn"
          phx-click="toggle_mute"
          class={"group relative w-14 h-14 rounded-2xl flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg #{if @muted, do: "bg-gradient-to-br from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 shadow-red-500/30", else: "bg-bgSecondary/60 hover:bg-bgSecondary/80 backdrop-blur-md border-2 border-gray-300/50 shadow-md"}"}
          title="Mute/Unmute"
        >

          <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-gray-900/95 backdrop-blur-sm text-white text-xs font-medium rounded-lg px-3 py-1.5 opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none shadow-xl whitespace-nowrap">
            {if @muted, do: "Unmute", else: "Mute"}
          </div>
        </button>
        
<!-- Camera -->
        <button
          id="video-btn"
          phx-click="toggle_video"
          class={"group relative w-14 h-14 rounded-2xl flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg #{if @video_enabled, do: "bg-bgSecondary/60 hover:bg-bgSecondary/80 backdrop-blur-md border-2 border-gray-300/50 shadow-md", else: "bg-gradient-to-br from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 shadow-red-500/30"}"}
          title={if @video_enabled, do: "Turn camera off", else: "Turn camera on"}
        >

          <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-gray-900/95 backdrop-blur-sm text-white text-xs font-medium rounded-lg px-3 py-1.5 opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none shadow-xl whitespace-nowrap">
            {if @video_enabled, do: "Turn off camera", else: "Turn on camera"}
          </div>
        </button>
        
<!-- Screen Share -->
        <button
          id="screenshare-btn"
          class="group relative w-14 h-14 bg-bgSecondary/60 hover:bg-bgSecondary/80 backdrop-blur-md rounded-2xl flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg border-2 border-gray-300/50 shadow-md"
          title="Share screen"
        >
          <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-gray-900/95 backdrop-blur-sm text-white text-xs font-medium rounded-lg px-3 py-1.5 opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none shadow-xl whitespace-nowrap">
            Share screen
          </div>
        </button>
        
<!-- Recording Button -->
        <div id="audio-recorder" phx-hook="AudioRecorder">
          <button
            id="recording-btn"
            phx-click={if @is_recording, do: "stop_recording", else: "start_recording"}
            class={"group relative w-14 h-14 rounded-2xl flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg #{if @is_recording, do: "bg-gradient-to-br from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 animate-pulse shadow-red-600/40", else: "bg-bgSecondary/60 hover:bg-bgSecondary/80 backdrop-blur-md border-2 border-gray-300/50 shadow-md"}"}
            title={if @is_recording, do: "Stop recording", else: "Start recording"}
          >
            <svg
              class={"w-6 h-6 transition-colors #{if @is_recording, do: "text-white", else: "text-gray-700"}"}
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <circle cx="12" cy="12" r="6"></circle>
            </svg>
            <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-gray-900/95 backdrop-blur-sm text-white text-xs font-medium rounded-lg px-3 py-1.5 opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none shadow-xl whitespace-nowrap">
              {if @is_recording, do: "Stop Recording", else: "Start Recording"}
            </div>
          </button>
        </div>
        
<!-- AI Assistant Button -->
        <button
          id="ai-btn"
          phx-click="toggle_ai_panel"
          class={"group relative w-14 h-14 bg-bgSecondary/60 hover:bg-bgSecondary/80 backdrop-blur-md rounded-2xl flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg border-2 shadow-md #{if @show_ai_panel, do: "border-bluePrimary/60 ring-2 ring-bluePrimary/30", else: "border-gray-300/50"}"}
          title="AI Assistant"
        >
          <svg
            class={"w-6 h-6 transition-colors #{if @show_ai_panel, do: "text-bluePrimary", else: "text-gray-700"}"}
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
            >
            </path>
          </svg>
          <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-gray-900/95 backdrop-blur-sm text-white text-xs font-medium rounded-lg px-3 py-1.5 opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none shadow-xl whitespace-nowrap">
            AI Assistant
          </div>
        </button>

        <div class="w-px h-10 bg-gradient-to-b from-transparent via-gray-300/50 to-transparent mx-2">
        </div>
        
<!-- End Call -->
        <button
          id="end-call-btn"
          phx-click="end_call"
          class="group relative w-14 h-14 bg-gradient-to-br from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 rounded-2xl flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-xl shadow-red-600/40"
          title="End call"
        >

          <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-gray-900/95 backdrop-blur-sm text-white text-xs font-medium rounded-lg px-3 py-1.5 opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none shadow-xl whitespace-nowrap">
            End call
          </div>
        </button>
      </div>
    </div>
  </div>
  
<!-- AI Assistant Panel -->
  <div
    id="ai-panel"
    class={"absolute bottom-24 right-6 w-96 bg-white shadow-2xl rounded-xl transition-all duration-300 z-40 border border-gray-200 #{if @show_ai_panel, do: "opacity-100 translate-y-0", else: "opacity-0 translate-y-4 pointer-events-none"}"}
  >
    <div class="flex flex-col h-[500px]">
      <div class="p-4 border-b border-gray-200 bg-bluePrimary rounded-t-xl">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">

            <!--
            <div class="text-white flex flex-row gap-2 items-center">
              <h3 class="font-semibold">{gettext("Mia")}</h3>
              <span class="text-xs font-normal bg-white/20 px-2 py-0.5 rounded-full">
                {gettext("AI Meeting Assistant")}
              </span>
            </div>
            <%= if @is_recording do %>
              <span class="text-xs bg-white/20 text-white px-2 py-0.5 rounded-full">
                {gettext("Recording")}
              </span>
            <% end %>
            -->
          </div>
          <button phx-click="toggle_ai_panel" class="text-white hover:bg-white/10 rounded p-1">
          </button>
        </div>
      </div>

      <div class="flex-1 overflow-y-auto p-4 bg-gray-50">
        <%= if length(@transcript) > 0 do %>
          <div class="space-y-3 mb-4">
            <div class="flex items-center space-x-2 mb-2">
              <svg
                class="w-4 h-4 text-gray-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                >
                </path>
              </svg>
              <span class="text-sm font-medium text-gray-700">Live Transcript</span>
            </div>
            <%= for entry <- Enum.take(@transcript, -5) do %>
              <div class="bg-white rounded-lg p-3 shadow-sm border border-gray-200">
                <div class="flex items-start justify-between mb-1">
                  <span class="text-xs font-medium text-blue-600">{entry.speaker}</span>
                  <span class="text-xs text-gray-500">{format_timestamp(entry.timestamp)}</span>
                </div>
                <p class="text-sm text-gray-800">{entry.text}</p>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8">
            <svg
              class="w-12 h-12 text-gray-400 mx-auto mb-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
              >
              </path>
            </svg>
            <p class="text-sm text-gray-500">Start recording to see live transcription</p>
          </div>
        <% end %>
        
<!-- AI Response -->
        <%= if @ai_response do %>
          <div class="mt-4">
            <div class="flex items-center space-x-2 mb-2">
              <svg class="w-4 h-4 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z">
                </path>
              </svg>
              <span class="text-sm font-medium text-purple-700">AI Answer</span>
            </div>
            <div class="bg-gradient-to-br from-purple-50 to-blue-50 rounded-lg p-4 shadow-sm border border-purple-200">
              <p class="text-sm text-gray-800 whitespace-pre-wrap">{@ai_response}</p>
            </div>
          </div>
        <% end %>
      </div>
      
<!-- Quick Questions -->
      <div class="p-4 border-t border-gray-200 bg-white rounded-b-xl">
        <div class="mb-3">
          <label class="text-xs font-medium text-gray-700 mb-2 block">Quick Questions</label>
          <div class="flex flex-wrap gap-2">
            <%= for question <- Enum.take(@suggested_questions, 3) do %>
              <button
                phx-click="ask_ai"
                phx-value-question={question}
                class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 px-3 py-1.5 rounded-full transition-colors border border-blue-200"
              >
                {question}
              </button>
            <% end %>
          </div>
        </div>
        
<!-- Custom Question Input -->
        <form phx-submit="ask_ai" class="flex space-x-2">
          <input
            type="text"
            name="question"
            placeholder="Ask about the conversation..."
            class="flex-1 text-sm px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            autocomplete="off"
          />
          <button
            type="submit"
            class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors"
          >
            Ask
          </button>
        </form>
      </div>
    </div>
  </div>
  
<!-- Participants Sidebar (Hidden by default) -->
  <div
    id="participants-sidebar"
    class="absolute top-0 right-0 w-80 h-full bg-white shadow-2xl transform translate-x-full transition-transform duration-300 z-30 hidden border-l border-gray-200"
  >
    <div class="h-full flex flex-col">
      <!-- Sidebar Header -->
      <div class="p-4 border-b border-gray-200">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold text-gray-900">Participants</h3>
          <button id="close-participants" class="p-1 text-gray-500 hover:text-gray-700 rounded">
          </button>
        </div>
      </div>
      
<!-- Participants List -->
      <div class="flex-1 overflow-y-auto p-4">
        <div class="space-y-3">
          <!-- You -->
          <div class="flex items-center space-x-3 p-2 rounded-lg bg-blue-50 border border-blue-200">
            <div class="w-8 h-8 bg-bluePrimary rounded-full flex items-center justify-center">
              <span class="text-white text-sm font-medium">Y</span>
            </div>
            <div class="flex-1">
              <div class="text-sm font-medium text-gray-900">You</div>
              <div class="text-xs text-gray-500">Host</div>
            </div>
            <div class="flex space-x-1">
              <div class="w-4 h-4 bg-red-500 rounded-full flex items-center justify-center">
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
